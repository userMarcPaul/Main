# Copy to .env.local. The app now uses Supabase (Postgres), so dev and tests
# need a Supabase project — set its URL and SERVICE-ROLE key here. The
# service-role key is server-side only (it bypasses row-level security); never
# expose it to the browser.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role key from Supabase → Project Settings → API>

# The email that gets the admin role on sign-up.
ADMIN_EMAIL=you@example.com

# Password for the demo account created by `npm run seed:demo`.
DEMO_PASSWORD=DemoPass123!

# Production origin for sitemap generation (`npm run sitemap`).
SITE_URL=https://ecb-eats.vercel.app

# Image uploads: leave empty to store on local disk. In production set this to
# the name of a PUBLIC Supabase Storage bucket (e.g. recipe-images) and photos
# are uploaded there instead.
SUPABASE_STORAGE_BUCKET=

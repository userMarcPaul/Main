# Copy to .env.local. The local file database needs no Turso account;
# production uses libsql://<your-db>.turso.io with a token.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# The email that gets the admin role on sign-up.
ADMIN_EMAIL=you@example.com

# Password for the demo account created by `npm run seed:demo`.
# Default: DemoPass123!
DEMO_PASSWORD=DemoPass123!

# Production origin for sitemap generation (`npm run sitemap`).
# Leave blank during local development.
SITE_URL=https://ecb-eats.vercel.app
